NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/restopilot
JWT_ACCESS_SECRET=access_secret_for_development_only
JWT_REFRESH_SECRET=refresh_secret_for_development_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

LOG_LEVEL=info

# Cashfree Payment Gateway
CASHFREE_ENV=sandbox
CASHFREE_APP_ID_TEST=your_cashfree_test_app_id
CASHFREE_SECRET_KEY_TEST=your_cashfree_test_secret_key
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
P U P P E T E E R _ E X E C U T A B L E _ P A T H = / u s r / b i n / c h r o m i u m 
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Sentry Configuration
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
